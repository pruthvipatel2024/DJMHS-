# SDJM High School ERP - Frontend Environment Configuration

# ------------------------------------------------------------------------------
# 1. DEPLOYMENT SCENARIO A: Frontend & Backend on DIFFERENT hosts / domains
# (e.g. Frontend on Vercel/Netlify, Backend on Render/Railway/VPS)
# Set VITE_API_URL to your full live backend domain URL with /api suffix:
# VITE_API_URL=https://your-backend-api.onrender.com/api

# 2. DEPLOYMENT SCENARIO B: Frontend & Backend on the SAME domain or Nginx proxy
# Set VITE_API_URL to relative path:
# VITE_API_URL=/api
# ------------------------------------------------------------------------------

# Live Production Backend API Endpoint:
VITE_API_URL=http://localhost:5000/api
